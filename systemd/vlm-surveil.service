[Unit]
Description=Surveil: VLM-Based Danger Detection & 3D Mapping System
After=network.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi

# Adjust path to the repository directory
WorkingDirectory=/home/pi/Surveil

# Use the virtual environment's Python if applicable
ExecStart=/usr/bin/python3 src/main.py

# Auto-restart on crash
Restart=always
RestartSec=10

# Security constraints
ProtectSystem=full
NoNewPrivileges=true

# Environment Variables (for unbuffered logging & API Key)
Environment=PYTHONUNBUFFERED=1
Environment=SURVEIL_API_KEY=vlm_super_secret_key_123

[Install]
WantedBy=multi-user.target
